{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enterprise-ppt-skill.local/schemas/rule.schema.json",
  "title": "Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "scope",
    "statement",
    "observed_value",
    "priority",
    "frequency",
    "evidence",
    "exceptions",
    "status"
  ],
  "properties": {
    "rule_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "observed_value": {},
    "priority": {
      "enum": ["MUST", "SHOULD", "MAY", "CONDITIONAL", "UNKNOWN"]
    },
    "frequency": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "exceptions": { "type": "array" },
    "status": {
      "enum": ["candidate", "approved", "deprecated", "rejected"]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "slide_number",
        "element_ref",
        "source_type",
        "locator"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "slide_number": { "type": "integer", "minimum": 1 },
        "element_ref": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
