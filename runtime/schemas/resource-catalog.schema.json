{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resource-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "resources"],
  "properties": {
    "catalogVersion": { "$ref": "#/definitions/semver" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/definitions/resourceRecord" }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$"
    },
    "resourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "kind",
        "scope",
        "version",
        "sha256",
        "path",
        "status",
        "allowedPurposes"
      ],
      "properties": {
        "resourceId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "template",
            "token-set",
            "layout",
            "asset",
            "rule-set",
            "evidence-index",
            "font-license",
            "qa-policy",
            "style-manifest"
          ]
        },
        "scope": { "enum": ["core", "company", "style", "request", "quarantine"] },
        "companyId": { "$ref": "#/definitions/identifier" },
        "styleId": { "$ref": "#/definitions/identifier" },
        "version": { "$ref": "#/definitions/semver" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "status": { "enum": ["candidate", "approved", "deprecated", "rejected"] },
        "allowedPurposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["observe", "route", "generate", "qa", "review"] }
        },
        "exportPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "consumerStyleIds"],
          "properties": {
            "mode": { "const": "allow-listed" },
            "consumerStyleIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/identifier" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "core" } }, "required": ["scope"] },
          "then": { "not": { "anyOf": [{ "properties": { "companyId": {} }, "required": ["companyId"] }, { "properties": { "styleId": {} }, "required": ["styleId"] }] } },
          "else": { "properties": { "companyId": {} }, "required": ["companyId"] }
        },
        {
          "if": { "properties": { "scope": { "const": "style" } }, "required": ["scope"] },
          "then": { "properties": { "styleId": {} }, "required": ["styleId"] }
        },
        {
          "if": { "properties": { "kind": { "const": "style-manifest" } }, "required": ["kind"] },
          "then": { "properties": { "scope": { "const": "style" }, "styleId": {} }, "required": ["styleId"] }
        }
      ]
    }
  }
}
