{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enterprise-ppt-skill.local/schemas/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "category",
    "fact",
    "evidence",
    "confidence",
    "agent_id",
    "coverage",
    "missing_capabilities",
    "unknown_fields"
  ],
  "properties": {
    "observation_id": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "fact": { "type": "string", "minLength": 1 },
    "property": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "missing_capabilities": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "pptxRead",
          "pptxWrite",
          "renderSlides",
          "imageAnalysis",
          "parallelAgents"
        ]
      }
    },
    "unknown_fields": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "slide_number",
        "element_ref",
        "source_type",
        "locator"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "slide_number": { "type": "integer", "minimum": 1 },
        "element_ref": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
